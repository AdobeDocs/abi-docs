    "/api/abi/skills/ra/{si_id}/items/{item_id}/violations/{violation_id}": {
      "patch": {
        "tags": [
          "skills"
        ],
        "summary": "Accept, reject, or edit a violation",
        "description": "Apply user feedback to a single violation: set its review status (accept/reject, with an optional rejection reason and free-text detail) or edit its summary text. Returns the new version via an `ETag` response header.",
        "operationId": "update_ra_violation_skills_ra__si_id__items__item_id__violations__violation_id__patch",
        "parameters": [
          {
            "name": "si_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Si Id"
            }
          },
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Item Id"
            }
          },
          {
            "name": "violation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Violation Id"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The violation's current record_version, e.g. \"6\"",
              "title": "If-Match"
            },
            "description": "The violation's current record_version, e.g. \"6\""
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/SetReviewStatusAction"
                  },
                  {
                    "$ref": "#/components/schemas/ResetViolationAction"
                  },
                  {
                    "$ref": "#/components/schemas/EditViolationAction"
                  }
                ],
                "discriminator": {
                  "propertyName": "action",
                  "mapping": {
                    "setReviewStatus": "#/components/schemas/SetReviewStatusAction",
                    "resetViolation": "#/components/schemas/ResetViolationAction",
                    "editViolation": "#/components/schemas/EditViolationAction"
                  }
                },
                "title": "Update"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Feedback applied. The new version is in the `ETag` response header.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Quoted new record version, e.g. \"7\""
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          }
        },
        "x-public": true
      }
    },
