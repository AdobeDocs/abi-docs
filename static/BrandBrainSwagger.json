  "paths": {
    "/api/abi/skills/invocations": {
      "get": {
        "tags": [
          "skills"
        ],
        "summary": "List skill invocations",
        "description": "Return skill invocations submitted by the calling user within their tenant, newest first.",
        "operationId": "list_invocations_skills_invocations_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Maximum number of items to return per page. It is used as a hint only, actual response size may be smaller or larger. Check `page.next` to determine whether a further page is available.",
              "default": 50,
              "title": "Limit"
            },
            "description": "Maximum number of items to return per page. It is used as a hint only, actual response size may be smaller or larger. Check `page.next` to determine whether a further page is available."
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque pagination cursor from the previous page's `page.next`. Omit for the first page.",
              "title": "Start"
            },
            "description": "Opaque pagination cursor from the previous page's `page.next`. Omit for the first page."
          },
          {
            "name": "skill",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Skill"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Skill"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkillInvocationLogResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          }
        },
        "x-public": true
      }
    },
    "/api/abi/skills/ra": {
      "post": {
        "tags": [
          "skills"
        ],
        "summary": "Invoke RA skill",
        "description": "Enqueue a Relevance Advisor (RA) skill invocation for one or more items within a tenant campaign. Each item must belong to the specified tenant. Returns 202 immediately; processing is asynchronous. The invocation status is `queued` when under the concurrency cap, or `pending` when at capacity.",
        "operationId": "invoke_ra_skills_ra_post",
        "parameters": [
          {
            "name": "abi-use-preview-brand",
            "in": "header",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Abi-Use-Preview-Brand"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SkillRa"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkillInvocationResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          }
        },
        "x-public": true
      }
    },
    "/api/abi/skills/ra/{si_id}": {
      "get": {
        "tags": [
          "skills"
