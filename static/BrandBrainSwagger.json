  "components": {
    "schemas": {
      "Skill": {
        "type": "string",
        "enum": [
          "ra",
          "iassemble"
        ],
        "title": "Skill",
        "description": "Skills supported by ABI"
      },
      "SkillInvocationLogResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SkillInvocationLogEntry"
            },
            "type": "array",
            "title": "Items"
          },
          "page": {
            "$ref": "#/components/schemas/Page"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "page"
        ],
        "title": "SkillInvocationLogResponse"
      },
      "SkillInvocationLogEntry": {
        "properties": {
          "invocationId": {
            "type": "string",
            "format": "uuid",
            "title": "Invocationid"
          },
          "skill": {
            "$ref": "#/components/schemas/Skill"
          },
          "status": {
            "$ref": "#/components/schemas/SkillInvocationStatus"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "userId": {
            "type": "string",
            "title": "Userid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "invocationId",
          "skill",
          "status",
          "name",
          "userId",
          "createdAt"
        ],
        "title": "SkillInvocationLogEntry"
      },
      "SkillInvocationStatus": {
        "type": "string",
        "enum": [
          "pending",
          "queued",
          "running",
          "completed",
          "failed",
          "cancelled"
        ],
        "title": "SkillInvocationStatus",
        "description": "Lifecycle phase of a skill invocation job.\n\nTerminal states are COMPLETED (success — partial outcomes are visible\nin ``success_count`` / ``failure_count``), FAILED (workflow / activity\nraised), and CANCELLED (user intervention before completion)."
      },
      "Page": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "next": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "count"
        ],
        "title": "Page"
      },
      "ProblemDetails": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "default": "about:blank"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "abi_err_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abi Err Code"
          }
        },
        "type": "object",
        "required": [
          "title",
          "status",
          "detail"
        ],
        "title": "ProblemDetails",
        "description": "RFC 9457 Problem Details body\n(https://www.rfc-editor.org/rfc/rfc9457.html).\n\nMirrors the runtime shape produced by\n``app.core.error_handlers.build_error_response``. ``abi_err_code`` is an\nRFC-permitted extension specific to ABI domain errors — it identifies\nthe problem class programmatically while ``type`` provides the\nhuman-readable docs URI."
      },
      "SkillRa": {
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid",
            "title": "Tenantid"
          },
          "campaignId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Campaignid"
          },
          "displayName": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Displayname"
          },
          "notifyUrl": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notifyurl"
          },
          "validationContext": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ValidationContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/SkillRaItem"
            },
            "type": "array",
            "minItems": 1,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tenantId",
          "items"
        ],
        "title": "SkillRa",
        "description": "RA invocation — runs validations across a list of items."
      },
      "ValidationContext": {
        "properties": {
          "focusAreas": {
            "additionalProperties": {
              "items": {
                "type": "string",
                "maxLength": 255,
                "minLength": 1
              },
              "type": "array"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/FocusArea"
            },
            "type": "object",
            "title": "Focusareas"
          },
          "dimensions": {
            "additionalProperties": {
              "items": {
                "type": "string",
                "maxLength": 255,
                "minLength": 1
              },
              "type": "array"
            },
            "propertyNames": {
              "maxLength": 255,
              "minLength": 1
            },
            "type": "object",
