    "/api/abi/storage/temp": {
      "post": {
        "tags": [
          "storage"
        ],
        "summary": "Create temporary upload item",
        "description": "Generate a presigned upload URL for a temporary file scoped to the tenant's storage container. The URL expires in 1 hour. The tenant container must already be provisioned — this endpoint does not create it.",
        "operationId": "create_temp_item_storage_temp_post",
        "requestBody": {
          "content": {
