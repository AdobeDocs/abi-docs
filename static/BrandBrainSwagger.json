      }
    },
    "/api/abi/skills/ra/{si_id}/cancel": {
      "post": {
        "tags": [
          "skills"
        ],
        "summary": "Cancel an RA invocation",
        "description": "Cancel an RA skill invocation. Idempotent — cancelling an already-cancelled invocation returns 200. Returns 409 only when the invocation has already completed or failed. Response `status` is `cancelled`.",
